{
  "name": "pi-clarity",
  "version": "0.1.0",
  "description": "Model-aware response-presentation contracts for Pi",
  "license": "MIT",
  "files": [
    "extensions/**/*.ts",
    "prompts/**/*.md",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "pi": {
    "extensions": [
      "./extensions/clarity.ts"
    ]
  },
  "scripts": {
    "run": "tsx src/cli.ts run",
    "summarize": "tsx src/cli.ts summarize",
    "judge": "tsx src/cli.ts judge",
    "analyze": "tsx src/cli.ts analyze",
    "test": "tsx --test src/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "lint:secrets": "secretlint \"**/*\"",
    "lint:data": "node scripts/check-data-safety.mjs --all",
    "check": "npm run lint:secrets && npm run lint:data && npm run lint && npm run typecheck && npm test",
    "prepare": "node scripts/prepare.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@oxlint/plugins": "^1.83.0",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.5",
    "@types/node": "^22.15.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "oxlint": "^1.83.0",
    "prettier": "^3.9.8",
    "secretlint": "^13.0.5",
    "tsx": "^4.23.13",
    "typescript": "^5.8.0"
  }
}
