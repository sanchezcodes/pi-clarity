{
  "name": "pi-clarify-eval",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "run": "tsx src/cli.ts run",
    "summarize": "tsx src/cli.ts summarize",
    "judge": "tsx src/cli.ts judge",
    "analyze": "tsx src/cli.ts analyze",
    "test": "tsx --test src/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
