# Comma-separated provider/model pairs. These match the models documented by this repository.
PI_EVAL_MODELS=cliproxy-codex/gpt-5.6-sol,cliproxy-claude/claude-opus-5

# Conservative defaults; CLI flags override these values.
PI_EVAL_REPETITIONS=3
PI_EVAL_CONCURRENCY=2
PI_EVAL_MAX_CALLS=100
PI_EVAL_TIMEOUT_MS=600000
PI_EVAL_RESULTS_DIR=results/raw
PI_EVAL_PI_BIN=pi

# Provider credentials are read by the child `pi` processes. Configure the
# appropriate provider-specific variables or authenticate with `pi /login`.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
